# ==========================================
# UPI Without Internet - Environment Config
# ==========================================

# GEMINI_API_KEY: Optional - for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Backend Flask Configuration
FLASK_APP=backend/run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
DATABASE_URI=sqlite:///backend/instance/upi_offline.db
PORT=5001
MAX_PACKET_AGE_SECONDS=86400
DEMO_SEED=true
